# Configuración de IDs de usuario para permisos de Docker en Linux
CUR_UID=1000
CUR_GID=1000

# Orígenes permitidos por CORS en la API (separados por comas). "*" = todos.
# Con orígenes explícitos se habilitan credenciales automáticamente.
CORS_ALLOWED_ORIGINS=*

# Número de trials de Optuna en el servicio de entrenamiento (bajo = arranque rápido).
N_TRIALS=10
